// =============================================================================
// STUDIOFLOW — Prisma Schema (booking system tables)
// =============================================================================
// DB: libSQL/Turso (SQLite-compatible)
// NOTE: This schema coexists with the existing raw-SQL tables from the
//       LovelyGirls public site (girls, reviews, locations, etc.).
//       Only STUDIOFLOW-specific tables are defined here.
//       The existing `users` table is extended via ALTER TABLE (in SQL migration).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USERS (existing table — extended with display_name, is_active)
// Roles: admin | manager | operator | girl
// NOTE: Role CHECK constraint validated in application layer (SQLite can't ALTER CHECK)
// =============================================================================
// NOT modeled here — uses existing `users` table with raw SQL ALTER TABLE.
// See: scripts/migrate-studioflow-booking.sql

// =============================================================================
// BOOKING CLIENTS (encrypted PII — phone, name, surname stored as AES-256-GCM)
// Only operatorka + admin can decrypt. Girls see only nickname + visit count.
// Renamed from `clients` to avoid collision with future `members` table.
// =============================================================================
model BookingClient {
  id               Int       @id @default(autoincrement())
  clientNumber     String    @unique @map("client_number") // "KLIENT0001" — auto-generated
  nickname         String // "Josef", "M z HK" — displayed to girls
  phoneEncrypted   String?   @map("phone_encrypted") // AES-256-GCM ciphertext
  phoneHmac        String?   @map("phone_hmac") // HMAC-SHA256 for lookup (requires secret key)
  nameEncrypted    String?   @map("name_encrypted") // AES-256-GCM ciphertext
  surnameEncrypted String?   @map("surname_encrypted") // AES-256-GCM ciphertext
  emailEncrypted   String?   @map("email_encrypted") // AES-256-GCM ciphertext
  telegramId       String?   @map("telegram_id") // Telegram user ID (for bot)
  source           String    @default("phone") // phone | telegram | whatsapp | walkin | web
  trustLevel       String    @default("new") @map("trust_level") // new | verified | regular | vip
  totalVisits      Int       @default(0) @map("total_visits")
  totalSpent       Int       @default(0) @map("total_spent") // in CZK
  totalPoints      Int       @default(0) @map("total_points")
  noShowCount      Int       @default(0) @map("no_show_count")
  isBanned         Boolean   @default(false) @map("is_banned")
  banReason        String?   @map("ban_reason")
  notes            String? // internal notes (admin/operator only)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  bookings     Booking[]
  drafts       BookingDraft[]
  telegramUser TelegramUser?

  @@index([phoneHmac])
  @@index([telegramId])
  @@index([trustLevel])
  @@map("booking_clients")
}

// =============================================================================
// BOOKINGS V2 (main reservation table)
// Status flow: DRAFT -> PENDING -> CONFIRMED -> IN_PROGRESS -> COMPLETED
//                                                           -> NO_SHOW
//                                -> DECLINED
//                    -> EXPIRED (timeout)
//                                -> CANCELLED_CLIENT
//                                -> CANCELLED_GIRL
//                                -> RESCHEDULED -> CONFIRMED
//                                -> REASSIGNED  -> CONFIRMED
// =============================================================================
model Booking {
  id              Int       @id @default(autoincrement())
  clientId        Int       @map("client_id")
  girlId          Int       @map("girl_id") // FK to existing girls table
  locationId      Int?      @map("location_id") // FK to existing locations table
  date            String // YYYY-MM-DD (Prague timezone)
  startTime       String    @map("start_time") // HH:MM
  endTime         String    @map("end_time") // HH:MM
  durationMinutes Int       @map("duration_minutes") // 30, 45, 60, 90, 120
  programId       Int?      @map("program_id") // FK to existing pricing_plans
  extras          String?   @default("[]") // JSON array of extra IDs
  price           Int? // total price in CZK (null = not yet calculated)
  pointsEarned    Int       @default(0) @map("points_earned")
  status          String    @default("pending") // draft | pending | confirmed | in_progress | completed | no_show | declined | expired | cancelled_client | cancelled_girl | rescheduled | reassigned
  channel         String    @default("phone") // phone | telegram | whatsapp | admin | sms
  source          String? // detail: "bot_flow", "manual", "deep_link"
  notes           String? // operator notes
  girlNotes       String?   @map("girl_notes") // notes visible to girl only
  declineReason   String?   @map("decline_reason")
  cancelReason    String?   @map("cancel_reason")
  noShowLevel     Int?      @map("no_show_level") // 1, 2, 3 (escalation)
  confirmedAt     DateTime? @map("confirmed_at")
  arrivedAt       DateTime? @map("arrived_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdBy       Int?      @map("created_by") // users.id
  updatedBy       Int?      @map("updated_by") // users.id
  slotVersion     Int       @default(0) @map("slot_version") // optimistic locking
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  client BookingClient @relation(fields: [clientId], references: [id])

  @@index([girlId, date])
  @@index([clientId])
  @@index([status])
  @@index([girlId, date, startTime, status]) // slot availability check
  @@map("bookings_v2")
}

// =============================================================================
// BOOKING DRAFTS (real-time sync: bot client is building a reservation)
// Visible to operatorka in calendar as yellow dashed block.
// Expires after 30 minutes -> slot freed.
// =============================================================================
model BookingDraft {
  id              Int       @id @default(autoincrement())
  clientId        Int?      @map("client_id")
  telegramChatId  String?   @map("telegram_chat_id") // TG chat ID for responses
  girlId          Int?      @map("girl_id")
  date            String? // YYYY-MM-DD (may be null if not yet selected)
  startTime       String?   @map("start_time")
  endTime         String?   @map("end_time")
  durationMinutes Int?      @map("duration_minutes")
  channel         String    @default("telegram") // telegram | whatsapp
  sessionId       String    @unique @map("session_id") // unique per bot conversation
  step            String    @default("select_girl") // select_girl | select_day | select_time | select_duration | confirm
  expiresAt       DateTime  @map("expires_at") // created_at + 30 min
  isConverted     Boolean   @default(false) @map("is_converted")
  convertedToId   Int?      @map("converted_to_id") // bookings_v2.id
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  client BookingClient? @relation(fields: [clientId], references: [id])

  @@index([girlId, date, startTime]) // slot blocking check
  @@index([expiresAt]) // cleanup cron
  @@index([telegramChatId])
  @@map("booking_drafts")
}

// =============================================================================
// TELEGRAM USERS (bot activation via deep link)
// Maps Telegram user ID to internal booking client.
// =============================================================================
model TelegramUser {
  id              Int       @id @default(autoincrement())
  telegramUserId  String    @unique @map("telegram_user_id") // Telegram numeric user ID
  telegramName    String?   @map("telegram_name") // first_name from TG
  clientId        Int       @unique @map("client_id")
  chatId          String?   @map("chat_id") // for sending messages
  activationToken String?   @map("activation_token") // deep link token (one-time)
  isActive        Boolean   @default(true) @map("is_active")
  activatedAt     DateTime? @map("activated_at")
  lastInteraction DateTime? @map("last_interaction")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  client BookingClient @relation(fields: [clientId], references: [id])

  @@map("telegram_users")
}

// =============================================================================
// BOOKING AUDIT LOG (all sensitive operations)
// Immutable — INSERT only, never UPDATE or DELETE.
// =============================================================================
model BookingAuditLog {
  id         Int      @id @default(autoincrement())
  bookingId  Int?     @map("booking_id") // FK to bookings_v2.id (nullable)
  userId     Int?     @map("user_id") // users.id (null = system/bot)
  action     String // booking.create | booking.confirm | client.decrypt | login.success | ...
  actorType  String   @default("user") @map("actor_type") // user | bot | system | cron
  entityType String?  @map("entity_type") // booking | client | draft
  entityId   Int?     @map("entity_id")
  details    String?  @default("{}") // JSON — what changed, old/new values
  ipHash     String?  @map("ip_hash") // HMAC of IP
  userAgent  String?  @map("user_agent")
  severity   String   @default("info") // info | warn | critical
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([bookingId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
  @@map("booking_audit_log")
}

// =============================================================================
// SLOT LOCKS (prevents race conditions — short-lived row-level locks)
// Used by first-write-wins mechanism.
// =============================================================================
model SlotLock {
  id        Int      @id @default(autoincrement())
  girlId    Int      @map("girl_id")
  date      String // YYYY-MM-DD
  startTime String   @map("start_time") // HH:MM
  endTime   String   @map("end_time") // HH:MM
  lockedBy  String   @map("locked_by") // "draft:123" | "booking:456"
  expiresAt DateTime @map("expires_at") // auto-expire for drafts
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([girlId, date, startTime, endTime])
  @@index([expiresAt])
  @@map("slot_locks")
}
